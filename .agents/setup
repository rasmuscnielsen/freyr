#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export DEBIAN_FRONTEND=noninteractive

step() {
    printf '\n==> %s\n' "$1"
    shift
    time "$@"
}

install_system_packages() {
    local packages=(ca-certificates curl gnupg unzip redis-server
        php8.5-cli php8.5-curl php8.5-mbstring php8.5-xml php8.5-zip
        php8.5-sqlite3 php8.5-pgsql php8.5-intl php8.5-bcmath php8.5-gmp
        php8.5-redis)
    local missing=() package
    for package in "${packages[@]}"; do
        if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
            missing+=("$package")
        fi
    done
    if ((${#missing[@]})); then
        # Match the Sury repository to the running Debian release: its PHP
        # packages link against release-specific libraries (libicu, libzip).
        local codename source
        codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"
        source="deb [signed-by=/usr/share/keyrings/freyr-php.gpg] https://packages.sury.org/php/ $codename main"
        if [[ "$(cat /etc/apt/sources.list.d/freyr-php.list 2>/dev/null)" != "$source" ]]; then
            curl -fsSL https://packages.sury.org/php/apt.gpg | sudo tee /usr/share/keyrings/freyr-php.gpg >/dev/null
            echo "$source" | sudo tee /etc/apt/sources.list.d/freyr-php.list >/dev/null
        fi
        sudo apt-get update -qq
        sudo apt-get install -y --no-install-recommends "${missing[@]}"
    fi
    php -r 'exit(PHP_VERSION_ID >= 80500 && PHP_VERSION_ID < 80600 ? 0 : 1);'
}

install_package_managers() {
    # Node is provided by the orb image; Vite 8 requires a modern Node release.
    node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 12)) process.exit(1)'
    if ! command -v composer >/dev/null; then
        local installer
        installer="$(mktemp)"
        curl -fsSL https://getcomposer.org/installer -o "$installer"
        local expected actual
        expected="$(curl -fsSL https://composer.github.io/installer.sig)"
        actual="$(sha384sum "$installer" | cut -d ' ' -f 1)"
        if [[ "$actual" != "$expected" ]]; then
            rm -f "$installer"
            echo 'Composer installer checksum mismatch' >&2
            return 1
        fi
        php "$installer" --2 --install-dir=/usr/local/bin --filename=composer
        rm -f "$installer"
    fi
    # The lockfile uses pnpm 9's format, supported by pnpm 10.
    if [[ "$(pnpm --version 2>/dev/null || true)" != '10.34.7' ]]; then
        npm install --global pnpm@10.34.7 --no-audit --no-fund
    fi
}

prepare_environment() {
    if [[ ! -f .env ]]; then
        cp -- .env.example .env
        # Orbs are development machines: use local mode and SQLite, as in
        # phpunit.xml. Never rewrite an existing env file.
        sed -i -e 's/^APP_ENV=.*/APP_ENV=local/' \
            -e 's/^APP_DEBUG=.*/APP_DEBUG=true/' \
            -e 's/^DB_CONNECTION=.*/DB_CONNECTION=sqlite/' \
            -e 's|^DB_DATABASE=.*|DB_DATABASE=database/database.sqlite|' .env
    fi
    if ! grep -Eq '^APP_KEY=.+$' .env; then
        php artisan key:generate --no-interaction
    fi
    if [[ ! -f database/database.sqlite ]]; then
        touch database/database.sqlite
    fi
    php artisan app:install --no-interaction
}

step 'System packages (PHP 8.5 and Redis)' install_system_packages
step 'Package managers' install_package_managers
step 'Composer dependencies' composer install --no-interaction --prefer-dist --no-progress
step 'Frontend dependencies' pnpm install --frozen-lockfile
step 'Local environment, migrations and default categories' prepare_environment
step 'Frontend assets and generated TypeScript routes' pnpm run build
printf '\nOrb setup ready. Run amp orb services ensure to open Freyr.\n'
